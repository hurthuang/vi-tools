<?xml version="1.0" encoding="utf-8"?>
<!-- 可攜版：dotnet publish -p:PublishProfile=Portable
     產生 dist\ViTools\（單一 ViTools.exe 內含 .NET 執行環境 + web\ + desktop-assets\）與 dist\ViTools-portable.zip -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <PublishDir>$(MSBuildProjectDirectory)\dist\ViTools\</PublishDir>
  </PropertyGroup>
</Project>
